# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-sairedis",
    version = "0.0.5",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "googletest", version = "1.16.0", repo_name = "com_google_googletest")
bazel_dep(name = "libnl3", version = "3.7.0.sonic.10")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "rules_perl", version = "1.1.2")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "rules_rs", version = "0.1.0", dev_dependency = True)

bazel_dep(name = "swig", version = "4.3.0.bcr.2")
bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")
bazel_dep(name = "sai", version = "1.18.0.sonic.2", repo_name = "sai_source")

# Select one landed infrastructure version for this root and Common. It keeps
# the existing snapshot-based Trixie inputs and required native interfaces.
single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.44-35726399908a3beb947174e9359f902077928289",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# Native libraries and headers use the shared, pinned Trixie dependency set.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "trixie",
    packages = [
        "zlib1g",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "trixie")

# Common also exports Rust bindings. This standalone C/C++ consumer does not
# build them, but the rules_rs facade needs an explicit root toolchain policy.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(versions = [])

# Select the SONiC tar implementation with reproducible timestamps.
single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

# Distroless uses rules_cc's private cc_import implementation; 0.2.21+ needs
# a C++ runtime toolchain type introduced after this workspace's Bazel 8.5.1.
single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)
